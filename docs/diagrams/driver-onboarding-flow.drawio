<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram name="Luồng tài xế gia nhập hệ thống">
    <mxGraphModel dx="1080" dy="970" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="970" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Luồng tài xế gia nhập hệ thống" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#263238;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1000" height="26" as="geometry"/></mxCell>
        <mxCell id="caption" value="Bốn cửa kiểm duyệt trước khi một chiếc xe được phép nhận đơn." style="text;html=1;fontSize=12;fontColor=#607D8B;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="1000" height="20" as="geometry"/></mxCell>
        <mxCell id="driver" value="Tài xế" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#5C6BC0;fontColor=#1A237E;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="reg" value="1. Đăng ký tài khoản&#10;POST /users/register" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="user" value="user_service&#10;tạo users + driver_profiles" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="kyc" value="2. Nộp hồ sơ KYC&#10;PUT /users/{id}/driver-profile" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="220" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="adminKyc" value="Admin duyệt KYC&#10;PUT /admin/kyc/{id}/review" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#5C6BC0;fontColor=#1A237E;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="220" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="kycOk" value="kyc_status = approved" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;fontColor=#795548;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="220" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="veh" value="3. Đăng ký xe&#10;POST /vehicles" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="370" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="vehicle" value="vehicle_service&#10;tạo vehicles" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="370" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="doc" value="4. Nộp giấy tờ xe&#10;POST /vehicles/{id}/documents" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="adminDoc" value="Admin duyệt giấy tờ&#10;PUT /admin/vehicles/{id}/verify" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#5C6BC0;fontColor=#1A237E;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="520" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="verified" value="verification_status&#10;= verified" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;fontColor=#795548;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="online" value="5. Bật nhận đơn&#10;POST /drivers/{id}/availability" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="670" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="check" value="Kiểm tra: đã duyệt?&#10;không bảo dưỡng? toạ độ hợp lệ?" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;fontColor=#795548;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="670" width="220" height="78" as="geometry"/></mxCell>
