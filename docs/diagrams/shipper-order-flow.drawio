        <mxCell id="caption" value="Vòng thương lượng: bid → offer → accept/reject. Mỗi bước đều sinh thông báo." style="text;html=1;fontSize=12;fontColor=#607D8B;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="1260" height="20" as="geometry"/></mxCell>
