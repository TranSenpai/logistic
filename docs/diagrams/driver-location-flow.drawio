        <mxCell id="nginx" value="Nginx&#10;rate-limit riêng 60r/s" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;fontColor=#B71C1C;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="220" height="78" as="geometry"/></mxCell>
