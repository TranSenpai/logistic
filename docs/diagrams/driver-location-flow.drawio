<mxfile host="app.diagrams.net" type="device">
  <diagram name="Luồng GPS và tìm xe đang chạy">
    <mxGraphModel dx="1080" dy="970" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="970" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Luồng GPS và tìm xe đang chạy" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#263238;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1000" height="26" as="geometry"/></mxCell>
        <mxCell id="caption" value="Postgres là nguồn sự thật; Redis GEO là chỉ mục tìm kiếm dựng lại được." style="text;html=1;fontSize=12;fontColor=#607D8B;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="1000" height="20" as="geometry"/></mxCell>
