    "definitions": {
        "internal_controller.AcceptMatchReq": {
            "type": "object",
            "required": [
                "ask_id",
                "bid_id",
                "consensus_price"
            ],
            "properties": {
                "ask_id": {
                    "type": "string"
                },
                "bid_id": {
                    "type": "string"
